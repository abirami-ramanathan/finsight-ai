# ==============================

.venv/
venv/
env/
ENV/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==============================
# IDE / OS
# ==============================

.vscode/
.idea/
.DS_Store
Thumbs.db

# ==============================
# Environment / Secrets
# ==============================

.env
.env.*
!.env.example

# ==============================
# Raw / Processed Data
# ==============================

data/raw/*
data/processed/*
data/documents/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/documents/.gitkeep

