# Logs
# ==============================

*.log
logs/

# ==============================
# Temporary Files
# ==============================

*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ==============================
# Build / Distribution
# ==============================

build/
dist/
*.egg-info/

# ==============================
# Output Files
# ==============================
# Keep CSV, images, JSON and documentation
# while excluding any model artifacts that
# may accidentally appear inside outputs.

outputs/*
!outputs/

!outputs/**/*.csv
!outputs/**/*.png
!outputs/**/*.jpg
!outputs/**/*.jpeg
!outputs/**/*.gif
!outputs/**/*.svg

!outputs/**/*.json
!outputs/**/*.txt
!outputs/**/*.md
!outputs/**/*.pdf
!outputs/**/*.docx

!outputs/**/.gitkeep

# Explicitly exclude model files even if
# they somehow appear inside outputs/

outputs/**/*.h5
outputs/**/*.keras
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.safetensors
outputs/**/*.bin
outputs/**/*.onnx
outputs/**/*.faiss
outputs/**/*.index
outputs/**/*.pkl
outputs/**/*.pickle
outputs/**/*.joblib
outputs/**/*.model
outputs/**/*.weights
outputs/**/*.ckpt
outputs/**/*.tflite

# ==============================
# Large Archives
# ==============================

*.zip
*.7z
*.rar
*.tar
*.gz