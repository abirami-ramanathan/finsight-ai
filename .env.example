APP_NAME=FinSight AI
API_HOST=127.0.0.1
API_PORT=8000

# Data
DATA_DIR=data
MODEL_DIR=models
OUTPUT_DIR=outputs

# Forecasting
LOOKBACK=30
EPOCHS=20
BATCH_SIZE=32
LEARNING_RATE=0.001

# Drift
PSI_THRESHOLD=0.20
KL_THRESHOLD=0.20
ERROR_WINDOW=30

# RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_TOKEN=

# Optional translation service; leave blank to use the local bridge/fallback.
TRANSLATION_ENABLED=true

# Recommendation
BANDIT_ALPHA=1.0
